@model IEnumerable<ProductListItemModel>

@{
    ViewData["Title"] = "Product list";
}

<div>
    <h2>@ViewBag.Title</h2>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.CategoryName</td>
                </tr>
            }
        </tbody>
    </table>
</div>